# ============================================================
# RUNTIME ENVIRONMENT
# ============================================================
# NODE_ENV: "production" disables demo user seeding and Vite HMR
NODE_ENV="development"

# PORT: HTTP listen port (default: 3000)
PORT="3000"

# ============================================================
# DATABASE — Cloud SQL (PostgreSQL)
# ============================================================
# Cloud SQL Unix socket path (Cloud Run) or TCP host (local dev)
SQL_HOST="/app/cloudsql"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Connection pool size (default: 10)
DB_POOL_MAX="10"

# ============================================================
# FILE STORAGE
# ============================================================
# GCS_BUCKET: If set, uploads are stored in Google Cloud Storage.
# Leave empty to use local disk (./uploads/) — not safe for Cloud Run production.
# The service account must have roles/storage.objectAdmin on the bucket.
GCS_BUCKET=""

# ============================================================
# SECURITY
# ============================================================
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production.
# Example: "https://surat.yourcompany.co.id,https://www.yourcompany.co.id"
ALLOWED_ORIGINS=""

# ============================================================
# APPLICATION
# ============================================================
# APP_URL: Public base URL of the service (used for self-referential links)
APP_URL="http://localhost:3000"

# DISABLE_HMR: Set to "true" to disable Vite HMR (useful in some Cloud environments)
DISABLE_HMR="false"

# ============================================================
# EXTERNAL SERVICES (optional)
# ============================================================
# GEMINI_API_KEY: Google Gemini API key (if AI features are enabled)
GEMINI_API_KEY=""
